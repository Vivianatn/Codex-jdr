# Build-time facts of the public website (site/config.ts). Copy to .env.production.local
# (ignored by git): read by the production build and `npm run launch:check`. Values end up in public pages.

CODEX_SITE_URL=https://
CODEX_PUBLISHER_NAME=
# « Particulier », « Entreprise individuelle, SIREN … », « SAS au capital de …, RCS …, TVA … »…
CODEX_PUBLISHER_STATUS=
CODEX_PUBLISHER_ADDRESS=
CODEX_PUBLISHER_PHONE=
# Contact, GDPR requests, reports, DSA single point of contact (art. 11 and 12).
CODEX_CONTACT_EMAIL=
CODEX_PUBLICATION_DIRECTOR=
CODEX_HOST_ADDRESS=
CODEX_HOST_PHONE=
# Where the data centre is, as a phrase: « en France ». Must be in the EU (privacy notice).
CODEX_HOST_LOCATION=
# The service behind SMTP_URL, with its country: « Brevo (France) ». Choose one in the EU.
CODEX_MAIL_PROVIDER=
# Consumer mediator (name + website) if the publisher acts as a professional; otherwise a phrase
# saying why it does not apply (decide it yourself or with a lawyer: Codex never guesses it).
CODEX_CONSUMER_MEDIATOR=
# RGAA status: « non conforme » until a full RGAA audit; then « partiellement conforme » / « totalement conforme ».
# CODEX_ACCESSIBILITY_STATUS=non conforme

# Umami website id (created in Umami's dashboard once the server runs). Public by nature.
VITE_UMAMI_WEBSITE_ID=
