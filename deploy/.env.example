# Copy to deploy/.env on the server and fill in. Never commit the real file.

# Domain of the site, without https:// (e.g. codex-jdr.fr). Its DNS A/AAAA records point to the server.
CODEX_DOMAIN=
# E-mail for Let's Encrypt (certificate expiry notices).
ACME_EMAIL=

# Umami (audience measurement). Long random values: `openssl rand -hex 32`.
UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=
