# Copy to .env on the server and fill in. Never commit the real file.

# Domain of the site, without https:// (e.g. codex-jdr.fr). Its DNS A/AAAA records point to the server.
CODEX_DOMAIN=
# E-mail for Let's Encrypt (certificate expiry notices).
ACME_EMAIL=

# Umami (audience measurement). Long random values: `openssl rand -hex 32`.
UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=

# Codex's online server (D-262). Long random values: `openssl rand -hex 32`.
CODEX_DB_PASSWORD=
# Encrypts the campaigns at rest. Keep a copy somewhere safe, off the server:
# without it, the database and its backups cannot be read.
CODEX_DATA_KEY=

# E-mails (password reset). From your mail provider, e.g.
# smtps://user%40codex-jdr.fr:password@mail.example.com:465 (encode @ as %40 in the user).
# Empty: forgotten passwords cannot be reset by e-mail.
SMTP_URL=
MAIL_FROM=Codex <ne-pas-repondre@codex-jdr.fr>
# Where new reports of illegal content are announced (DSA, D-271), and the address
# moderation e-mails tell people to answer to. Usually the site's contact address.
MODERATION_EMAIL=

# Administration dashboard at https://<domain>/admin (D-275). Empty: nobody can sign in.
# ADMIN_PASSWORD_HASH comes from `npm run admin:hash` (prints the whole line, keep its single quotes:
# they stop docker compose from reading the $ signs). Never the password itself.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
