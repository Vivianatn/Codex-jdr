{
  "name": "codex-server",
  "private": true,
  "version": "0.1.0-alpha",
  "description": "Codex online server: accounts, campaigns, sync and live-game relay (D-262)",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server/src/index.js",
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "admin:hash": "node --experimental-strip-types --no-warnings src/adminHash.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "fastify": "^5.12.7",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "typescript": "^6.0.3"
  },
  "main": "dist/server/src/index.js"
}
